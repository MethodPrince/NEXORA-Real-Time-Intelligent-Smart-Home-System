NEXORA_APP_NAME=NEXORA
NEXORA_ENVIRONMENT=development
NEXORA_LOG_LEVEL=INFO
NEXORA_JWT_SECRET_KEY=
NEXORA_ACCESS_TOKEN_EXPIRE_MINUTES=30
